---
// 404 bilíngue (o Cloudflare Pages serve este arquivo para qualquer rota inexistente).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { copy } from '../lib/content';
const c = copy.notFound;
---

<Base title={c.seoTitle.pt} description={c.body.pt}>
  <Header lang="pt" slot="header" />
  <section class="section surface-ink texture-noise" aria-labelledby="nf-title">
    <div class="container wrap">
      <p class="code" aria-hidden="true">
        404
      </p>
      <h1 id="nf-title">{c.title.pt}</h1>
      <p class="lead">{c.body.pt}</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">
          <Icon name="chevronLeft" />
          {c.home.pt}
        </a>
      </div>
      <hr />
      <div lang="en">
        <p class="en-title">{c.title.en}</p>
        <p class="lead">{c.body.en}</p>
        <a class="btn btn-ghost btn-sm" href="/en/">
          <Icon name="chevronLeft" size={18} />
          {c.home.en}
        </a>
      </div>
    </div>
  </section>
  <Footer lang="pt" slot="footer" />
</Base>

<style>
  .wrap {
    max-width: 40rem;
    min-height: 60dvh;
  }
  .code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 22vw, 11rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 2px var(--brass);
  }
  h1 {
    margin-block: var(--space-4);
  }
  .lead {
    color: var(--steel);
  }
  .actions {
    margin-top: var(--space-5);
  }
  hr {
    margin-block: var(--space-7) var(--space-5);
    border: 0;
    border-top: 1px solid var(--line);
  }
  .en-title {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 800;
    text-transform: uppercase;
  }
  .en-title + .lead {
    margin-bottom: var(--space-4);
  }
</style>
