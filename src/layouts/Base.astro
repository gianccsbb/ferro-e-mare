---
import '../styles/global.css';
import { getLangFromUrl, htmlLang, useTranslations, alternatePath } from '../i18n/ui';

interface Props {
  title: string; // ≤ 60 caracteres
  description: string; // ≤ 155 caracteres
  /** Páginas do negócio fictício = noindex (handout §8). Só /case é indexável. */
  index?: boolean;
}

const { title, description, index = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ptAlt = new URL(alternatePath(Astro.url.pathname, 'pt'), Astro.site);
const enAlt = new URL(alternatePath(Astro.url.pathname, 'en'), Astro.site);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={ptAlt} />
    <link rel="alternate" hreflang="en" href={enAlt} />
    <link rel="alternate" hreflang="x-default" href={ptAlt} />
    <meta name="theme-color" content="#0F1720" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/big-shoulders-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      {t('skip.content')}
    </a>
    <slot name="header" />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  /* Espaço para a barra de ação fixa no mobile não cobrir o rodapé. */
  @media (max-width: 767px) {
    body {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }
</style>
