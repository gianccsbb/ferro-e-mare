---
import '../styles/global.css';
import { getLangFromUrl, htmlLang, useTranslations, alternatePath } from '../i18n/ui';

interface Props {
  title: string; // ≤ 60 caracteres
  description: string; // ≤ 155 caracteres
  /** Páginas do negócio fictício = noindex (handout §8). Só /case é indexável. */
  index?: boolean;
}

const { title, description, index = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === 'pt' ? 'en' : 'pt';
const otherPath = alternatePath(Astro.url.pathname, otherLang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ptAlt = new URL(alternatePath(Astro.url.pathname, 'pt'), Astro.site);
const enAlt = new URL(alternatePath(Astro.url.pathname, 'en'), Astro.site);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={ptAlt} />
    <link rel="alternate" hreflang="en" href={enAlt} />
    <link rel="alternate" hreflang="x-default" href={ptAlt} />
    <meta name="theme-color" content="#0F1720" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/big-shoulders-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      {t('skip.content')}
    </a>
    <a
      class="lang-switch"
      href={otherPath}
      hreflang={htmlLang[otherLang]}
      lang={htmlLang[otherLang]}
      aria-label={t('lang.switch.label')}
    >
      {t('lang.switch')}
    </a>
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <p class="concept-notice">{t('notice.concept')}</p>
  </body>
</html>

<style>
  /* Provisório (Fase 1): o seletor de idioma vai para o Header na Fase 3. */
  .lang-switch {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgb(15 23 32 / 0.7);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
  }
  main:focus {
    outline: none;
  }
  .concept-notice {
    padding: var(--space-4) var(--gutter);
    background: var(--ink);
    color: var(--steel);
    font-size: var(--fs-small);
    text-align: center;
    border-top: 1px solid var(--line);
  }
</style>
