---
import type { Lang } from '../i18n/ui';
import { copy, reviews, translator, fmt } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
const c = copy.reviews;
---

<section id="avaliacoes" class="section surface-foam" aria-labelledby="avaliacoes-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t(c.eyebrow)}</p>
      <h2 id="avaliacoes-title">{t(c.title)}</h2>
      <p class="label">{t(c.label)}</p>
    </div>
    <ul class="list" role="list">
      {reviews.map((r) => (
        <li class="review plate">
          <figure>
            <p class="stars" role="img" aria-label={fmt(t(c.starsLabel), { n: r.stars })}>
              {Array.from({ length: r.stars }, () => (
                <Icon name="star" size={16} fill />
              ))}
            </p>
            <span class="qmark" aria-hidden="true">
              “
            </span>
            <blockquote>
              <p>“{t(r.text)}”</p>
            </blockquote>
            <figcaption>
              {r.author}, {t(r.place)}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .label {
    display: inline-block;
    justify-self: start;
    padding: 2px var(--space-2);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    color: var(--fg-muted);
  }
  .list {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .review {
    position: relative;
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: #fff9f0;
  }
  .qmark {
    position: absolute;
    top: -0.1em;
    right: var(--space-4);
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--brass);
    opacity: 0.35;
  }
  figure {
    display: grid;
    gap: var(--space-3);
    height: 100%;
    grid-template-rows: auto 1fr auto;
  }
  blockquote {
    font-size: 1.0625rem;
  }
  .stars {
    display: flex;
    gap: 2px;
    color: var(--brass-deep);
  }
  figcaption {
    padding-top: var(--space-3);
    border-top: 1px dashed var(--line-strong);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--fg-muted);
  }
  @media (min-width: 768px) {
    .list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
