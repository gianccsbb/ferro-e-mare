---
// Fotos reais entram aqui (src/assets/gallery/g1…g9). Enquanto não chegam,
// mostramos placas provisórias. Lightbox acessível na Fase 6.
import type { Lang } from '../i18n/ui';
import { copy, gallery, translator } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
const c = copy.gallery;
---

<section id="galeria" class="section surface-foam" aria-labelledby="galeria-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t(c.eyebrow)}</p>
      <h2 id="galeria-title">{t(c.title)}</h2>
    </div>
    <ul class="grid" role="list">
      {gallery.map((g, i) => (
        <li class:list={['tile', { big: i === 0 }]}>
          <div class="ph-photo" role="img" aria-label={t(g.alt)}>
            <Icon name="scissors" size={i === 0 ? 40 : 24} />
            <span>{t(g.alt)}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .tile {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .big {
    grid-column: span 2;
    aspect-ratio: 2 / 1.4;
  }
  .ph-photo {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-3);
    background:
      radial-gradient(circle at 30% 20%, rgb(224 160 74 / 0.25), transparent 60%),
      linear-gradient(160deg, #1d3a55, var(--ink));
    color: var(--brass);
    text-align: center;
  }
  .ph-photo span {
    color: var(--steel);
    font-size: 0.75rem;
    line-height: 1.35;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
    }
    .big {
      grid-column: span 2;
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }
</style>
