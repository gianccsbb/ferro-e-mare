---
// Mapa estilizado do Recife Antigo (ilha, rio, pontes, cais). Serve de
// "facade": na Fase 6, tocar nele carrega o mapa interativo real.
---

<svg class="map-art" viewBox="0 0 400 300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id="ma-water" width="14" height="8" patternUnits="userSpaceOnUse">
      <path
        d="M0 4c3.5-3 7-3 7 0s3.5 3 7 0"
        fill="none"
        stroke="#5e8a9a"
        stroke-opacity="0.35"
      ></path>
    </pattern>
    <radialGradient id="ma-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#e0a04a" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="#e0a04a" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <!-- Água -->
  <rect width="400" height="300" fill="#102236"></rect>
  <rect width="400" height="300" fill="url(#ma-water)"></rect>

  <!-- Continente (oeste) -->
  <path d="M0 0h120c-10 40 6 80-6 120s10 90-4 180H0z" fill="#16304a"></path>
  <!-- Ilha do Recife Antigo -->
  <path
    d="M176 30c40-10 92 0 110 30 14 24 6 60 12 92 6 34 0 76-26 100-28 26-80 28-104 4-22-22-14-62-18-96-4-34-14-66-2-92 6-16 14-34 28-38z"
    fill="#1b3a57"
    stroke="#5e8a9a"
    stroke-opacity="0.6"
    stroke-width="1.5"
  ></path>
  <!-- Molhe / quebra-mar (leste) -->
  <path
    d="M356 0c-6 60 4 140-4 300"
    stroke="#9aa4ae"
    stroke-opacity="0.5"
    stroke-width="5"
    fill="none"
  ></path>

  <!-- Ruas da ilha -->
  <g stroke="#9aa4ae" stroke-opacity="0.4" stroke-width="2" fill="none" stroke-linecap="round">
    <path d="M178 80h110M172 120h124M170 160h128M176 200h118M190 236h92"></path>
    <path d="M200 46v210M232 38v228M264 46v214"></path>
  </g>
  <!-- Rua principal destacada -->
  <path
    d="M170 140h128"
    stroke="#c08a3e"
    stroke-opacity="0.8"
    stroke-width="3"
    stroke-linecap="round"
  ></path>

  <!-- Pontes -->
  <g stroke="#f4efe6" stroke-opacity="0.55" stroke-width="4" stroke-linecap="round">
    <path d="M118 100h54M114 180h58M118 250h62"></path>
  </g>

  <!-- Pino -->
  <circle cx="232" cy="140" r="46" fill="url(#ma-glow)"></circle>
  <g transform="translate(232 140)">
    <path
      d="M0 0c-10-14-16-22-16-32a16 16 0 0 1 32 0c0 10-6 18-16 32z"
      fill="#e0a04a"
      stroke="#0f1720"
      stroke-width="2"
    ></path>
    <circle cy="-32" r="6" fill="#0f1720"></circle>
  </g>

  <!-- Rótulos -->
  <g font-family="Instrument Sans, sans-serif" font-weight="600" letter-spacing="2" fill="#f4efe6">
    <text x="236" y="186" font-size="10" text-anchor="middle" fill-opacity="0.85">
      RECIFE ANTIGO
    </text>
    <text x="40" y="150" font-size="8" fill-opacity="0.5" transform="rotate(-90 40 150)">
      CENTRO
    </text>
    <text x="378" y="160" font-size="8" fill-opacity="0.5" transform="rotate(90 378 160)">
      OCEANO ATLÂNTICO
    </text>
  </g>

  <!-- Rosa dos ventos -->
  <g transform="translate(70 254)" stroke="#c08a3e" fill="none" stroke-width="1.5">
    <circle r="16"></circle>
    <path d="M0-22v44M-22 0h44"></path>
    <path d="M0-14l4 14-4 14-4-14z" fill="#c08a3e"></path>
  </g>
  <text
    x="70"
    y="226"
    text-anchor="middle"
    font-family="Big Shoulders Display, sans-serif"
    font-weight="800"
    font-size="12"
    fill="#c08a3e"
  >
    N
  </text>
</svg>

<style>
  .map-art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
  }
</style>
