---
// Retrato estilizado (sem rosto realista: regra de honestidade do handout §8).
// Cada variante identifica a especialidade pelo cabelo/barba + ferramenta.
interface Props {
  variant: 'fade' | 'beard' | 'curly';
  number: string;
}
const { variant, number } = Astro.props;
const id = `pt-${variant}`;
---

<svg class="portrait" viewBox="0 0 200 220" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1b3550"></stop>
      <stop offset="1" stop-color="#0f1720"></stop>
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx="0.5" cy="0.3" r="0.6">
      <stop offset="0" stop-color="#e0a04a" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#e0a04a" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={`${id}-brass`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f0c27a"></stop>
      <stop offset="0.55" stop-color="#c08a3e"></stop>
      <stop offset="1" stop-color="#8a5a1c"></stop>
    </linearGradient>
    <clipPath id={`${id}-clip`}>
      <path d="M14 220V92a86 86 0 0 1 172 0v128z"></path>
    </clipPath>
  </defs>

  <g clip-path={`url(#${id}-clip)`}>
    <rect width="200" height="220" fill={`url(#${id}-bg)`}></rect>
    <rect width="200" height="220" fill={`url(#${id}-glow)`}></rect>

    <!-- Ferramenta ao fundo -->
    <g
      fill="none"
      stroke="#5e8a9a"
      stroke-opacity="0.45"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {variant === 'fade' && (
        <g transform="translate(140 40) rotate(20)">
          <rect x="0" y="0" width="26" height="60" rx="8" />
          <path d="M4 0V-8h18V0M4 -8v-4M9 -8v-4M13 -8v-4M17 -8v-4M22 -8v-4M8 22h10" />
        </g>
      )}
      {variant === 'beard' && (
        <g transform="translate(134 30) rotate(30)">
          <path d="M0 0h44l6 10H0z" />
          <path d="M0 10c-4 18-4 40 0 56h10c-2-16-2-38 0-56" />
        </g>
      )}
      {variant === 'curly' && (
        <g transform="translate(140 34) rotate(-15)">
          <circle cx="8" cy="52" r="8" />
          <circle cx="30" cy="52" r="8" />
          <path d="M12 45L34 0M26 45L4 0" />
        </g>
      )}
    </g>

    <!-- Busto -->
    <g stroke={`url(#${id}-brass)`} stroke-width="2.5" stroke-linejoin="round">
      <!-- Ombros com capa de barbeiro -->
      <path d="M22 220c6-44 36-62 78-62s72 18 78 62z" fill="#13283d"></path>
      <path d="M70 162l30 26 30-26" fill="none" stroke-opacity="0.7"></path>
      <!-- Pescoço -->
      <path d="M86 132v26c4 6 24 6 28 0v-26" fill="#1d3a55"></path>
      <!-- Cabeça (sem traços de rosto) -->
      <ellipse cx="100" cy="100" rx="32" ry="38" fill="#1d3a55"></ellipse>
      <!-- Orelhas -->
      <path d="M68 98c-6 0-8 12 0 16M132 98c6 0 8 12 0 16" fill="none"></path>
    </g>

    <!-- Cabelo / barba por variante -->
    {variant === 'fade' && (
      <g>
        <path
          d="M68 86c0-30 64-30 64 0v-10c0-6-2-16-6-18H74c-4 2-6 12-6 18z"
          fill={`url(#${id}-brass)`}
        />
        <g stroke="#c08a3e" stroke-linecap="round" stroke-width="2">
          <path d="M68 92h6M68 98h4M126 92h6M128 98h4" stroke-opacity="0.8" />
          <path d="M68 104h2M130 104h2" stroke-opacity="0.45" />
        </g>
        <path d="M74 58h52" stroke="#fff3d6" stroke-width="1.5" stroke-opacity="0.6" />
      </g>
    )}
    {variant === 'beard' && (
      <g fill={`url(#${id}-brass)`}>
        <path d="M70 84c2-26 58-26 60 0-10-10-50-10-60 0z" />
        <path d="M68 100c0 50 64 50 64 0-6 18-18 24-32 24s-26-6-32-24z" />
        <path d="M84 114c8-6 24-6 32 0-8 2-24 2-32 0z" />
      </g>
    )}
    {variant === 'curly' && (
      <g fill={`url(#${id}-brass)`}>
        <circle cx="76" cy="78" r="10" />
        <circle cx="90" cy="66" r="11" />
        <circle cx="106" cy="63" r="11" />
        <circle cx="121" cy="70" r="10" />
        <circle cx="129" cy="84" r="8" />
        <circle cx="70" cy="90" r="7" />
        <circle cx="98" cy="74" r="9" />
        <circle cx="114" cy="78" r="8" />
      </g>
    )}
  </g>

  <!-- Moldura em arco -->
  <path
    d="M14 220V92a86 86 0 0 1 172 0v128"
    fill="none"
    stroke={`url(#${id}-brass)`}
    stroke-width="2.5"
  ></path>

  <!-- Plaquinha numerada -->
  <g transform="translate(76 192)">
    <rect width="48" height="22" rx="4" fill="#1d4f8c" stroke="#f4efe6" stroke-width="1.5"></rect>
    <text
      x="24"
      y="16"
      text-anchor="middle"
      font-family="Big Shoulders Display, sans-serif"
      font-size="14"
      font-weight="800"
      fill="#f4efe6"
    >
      Nº {number}
    </text>
  </g>
</svg>

<style>
  .portrait {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
