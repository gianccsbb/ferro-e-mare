---
import type { Lang } from '../i18n/ui';
import { copy, business, hours, translator } from '../lib/content';
import { telLink, formatPhone } from '../lib/contact';
import { fmtTime } from '../lib/hours';
import Icon from './Icon.astro';
import MapArt from './art/MapArt.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
const c = copy.location;
const a = business.address;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(business.mapsQuery)}`;
// Facade: o iframe do Google só é criado quando a pessoa pede (LCP e privacidade).
const embedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&z=16&hl=${lang === 'pt' ? 'pt-BR' : 'en'}&output=embed`;
const days = t(c.days);
// Semana começando na segunda (como o cliente lê um horário).
const order = [1, 2, 3, 4, 5, 6, 0];
---

<section id="como-chegar" class="section surface-ink" aria-labelledby="como-chegar-title">
  <div class="container grid">
    <div class="info">
      <div class="section-head">
        <p class="eyebrow">{t(c.eyebrow)}</p>
        <h2 id="como-chegar-title">{t(c.title)}</h2>
      </div>

      <h3 class="label">
        <Icon name="pin" size={18} /> {t(c.addressLabel)}
      </h3>
      <address>
        {a.street}
        <br />
        {a.neighborhood} · {a.city}/{a.region}
      </address>

      <h3 class="label">
        <Icon name="clock" size={18} /> {t(c.hoursLabel)}
      </h3>
      <table class="hours">
        <tbody>
          {order.map((d) => {
            const h = hours.week[String(d)];
            return (
              <tr>
                <th scope="row">{days[d]}</th>
                <td>{h ? `${fmtTime(h[0], lang)} – ${fmtTime(h[1], lang)}` : t(c.closed)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <h3 class="label">
        <Icon name="phone" size={18} /> {t(c.phoneLabel)}
      </h3>
      <p>
        <a class="phone" href={telLink}>
          {formatPhone()}
        </a>
      </p>

      <div class="actions">
        <a class="btn btn-primary" href={mapsUrl} target="_blank" rel="noopener">
          <Icon name="pin" />
          {t(c.openMaps)}
        </a>
        <a class="btn btn-ghost" href={telLink}>
          <Icon name="phone" />
          {t(c.call)}
        </a>
      </div>
    </div>

    <figure class="map plate">
      <div class="map-frame" id="map-frame">
        <MapArt />
        <!-- Sem JS é um link para o Google Maps; com JS, carrega o mapa aqui mesmo. -->
        <a
          class="btn btn-primary map-load"
          href={mapsUrl}
          target="_blank"
          rel="noopener"
          data-embed={embedUrl}
          data-title={t(c.mapTitle)}
        >
          <Icon name="pin" />
          {t(c.loadMap)}
        </a>
      </div>
      <figcaption>{t(c.mapNote)}</figcaption>
    </figure>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLAnchorElement>('.map-load');
  btn?.addEventListener('click', (e) => {
    const frame = document.getElementById('map-frame');
    if (!frame || !btn.dataset.embed) return;
    e.preventDefault();
    const iframe = Object.assign(document.createElement('iframe'), {
      src: btn.dataset.embed,
      title: btn.dataset.title ?? '',
      loading: 'eager',
      referrerPolicy: 'no-referrer-when-downgrade',
      allowFullscreen: true,
    });
    frame.replaceChildren(iframe);
    frame.dataset.loaded = 'true';
    iframe.focus();
  });
</script>

<style>
  .grid {
    display: grid;
    gap: var(--space-7);
  }
  .label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass);
  }
  address {
    font-style: normal;
  }
  .hours {
    border-collapse: collapse;
    width: 100%;
    max-width: 22rem;
  }
  .hours th,
  .hours td {
    padding: var(--space-1) 0;
    text-align: left;
    font-weight: 400;
    border-bottom: 1px solid var(--line);
  }
  .hours td {
    text-align: right;
    color: var(--steel);
  }
  /* Telefone grande e clicável (persona "Seu Carlos"). */
  .phone {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    text-decoration: none;
  }
  .actions {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  @media (min-width: 480px) {
    .actions {
      display: flex;
      flex-wrap: wrap;
    }
  }
  .map {
    --rivet: rgb(192 138 62 / 0.6);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--brass);
    border-radius: var(--radius);
    background-color: #102236;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
  }
  .map-frame > :global(svg),
  .map-frame > :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map-load {
    position: absolute;
    left: 50%;
    bottom: var(--space-5);
    transform: translateX(-50%);
    white-space: nowrap;
    box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.7);
  }
  .map figcaption {
    padding: var(--space-3) var(--space-4);
    background: rgb(15 23 32 / 0.85);
    border-top: 1px solid var(--line);
    color: var(--steel);
    font-size: var(--fs-small);
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
