---
// Fase 3: só o modo degradado (sem JS). A ilha de 4 passos entra na Fase 5,
// montada dentro de #booking-root e substituindo este fallback.
import type { Lang } from '../i18n/ui';
import { copy, translator } from '../lib/content';
import { waLink, telLink, formatPhone } from '../lib/contact';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
const c = copy.booking;
---

<section id="agendar" class="section surface-navy" aria-labelledby="agendar-title">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow">{t(c.eyebrow)}</p>
      <h2 id="agendar-title">{t(c.title)}</h2>
      <p class="muted">{t(c.intro)}</p>
    </div>

    <div id="booking-root" class="panel plate">
      <div class="fallback">
        <p>{t(c.noJs)}</p>
        <div class="actions">
          <a class="btn btn-primary" href={waLink(t(c.whatsappGeneric))} rel="noopener">
            <Icon name="chat" />
            {t(copy.hero.ctaSecondary)}
          </a>
          <a class="btn btn-ghost" href={telLink}>
            <Icon name="phone" />
            {formatPhone()}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .narrow {
    max-width: 44rem;
  }
  .panel {
    --rivet: rgb(192 138 62 / 0.55);
    padding: var(--space-6) var(--space-5);
    border: 1px solid var(--brass);
    border-radius: var(--radius);
    background-color: var(--ink);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.8);
  }
  .fallback {
    display: grid;
    gap: var(--space-4);
  }
  .actions {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 480px) {
    .actions {
      display: flex;
      flex-wrap: wrap;
    }
  }
</style>
