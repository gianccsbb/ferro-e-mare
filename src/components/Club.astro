---
import type { Lang } from '../i18n/ui';
import { copy, translator } from '../lib/content';
import { waLink } from '../lib/contact';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
const c = copy.club;
---

<section id="clube" class="section surface-navy" aria-labelledby="clube-title">
  <div class="container">
    <article class="card plan">
      <div class="head">
        <p class="eyebrow">{t(c.eyebrow)}</p>
        <h2 id="clube-title">{t(c.title)}</h2>
        <p class="pitch">{t(c.pitch)}</p>
      </div>
      <p class="price">
        <span class="amount">{t(c.price)}</span>
        <span class="period">{t(c.period)}</span>
      </p>
      <ul class="benefits" role="list">
        {t(c.benefits).map((b) => (
          <li>
            <Icon name="check" size={18} />
            {b}
          </li>
        ))}
      </ul>
      <a class="btn btn-primary btn-block" href={waLink(t(c.whatsappMessage))} rel="noopener">
        {t(c.cta)}
        <Icon name="arrow" />
      </a>
    </article>
  </div>
</section>

<style>
  .plan {
    display: grid;
    gap: var(--space-5);
    max-width: 34rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-5);
    background: var(--ink);
    border-color: var(--brass);
  }
  .head {
    display: grid;
    gap: var(--space-2);
  }
  .pitch {
    color: var(--steel);
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }
  .amount {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--cta);
  }
  .period {
    color: var(--steel);
  }
  .benefits {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .benefits li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .benefits :global(.icon) {
    color: var(--brass);
    margin-top: 3px;
  }
</style>
