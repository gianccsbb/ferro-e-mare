---
import type { Lang } from '../i18n/ui';
import { copy, translator } from '../lib/content';
import { waLink } from '../lib/contact';
import Icon from './Icon.astro';
import HeroArt from './art/HeroArt.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
const c = copy.hero;
---

<section class="hero surface-ink texture-noise" aria-labelledby="hero-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">{t(c.eyebrow)}</p>
      <h1 id="hero-title">
        {t(c.h1)}
        <span class="accent">{t(c.h1Accent)}</span>
      </h1>
      <p class="sub">{t(c.sub)}</p>
      <div class="ctas">
        <a class="btn btn-primary btn-lg" href="#agendar">
          <Icon name="calendar" />
          {t(c.ctaPrimary)}
        </a>
        <a
          class="btn btn-ghost btn-lg"
          href={waLink(t(copy.booking.whatsappGeneric))}
          rel="noopener"
        >
          <Icon name="chat" />
          {t(c.ctaSecondary)}
        </a>
      </div>
      <div class="meta">
        <p class="proof">{t(c.proof)}</p>
        <ul class="perks" role="list">
          {t(c.perks).map((p) => (
            <li>
              <Icon name="check" size={16} />
              {p}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="media">
      <HeroArt label={t(c.imageAlt)} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-7);
  }
  .glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgb(224 160 74 / 0.18), transparent 60%);
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    gap: var(--space-7);
  }
  h1 {
    margin-block: var(--space-3) var(--space-4);
  }
  .accent {
    display: block;
    background: linear-gradient(100deg, #f0c27a 0%, var(--cta) 45%, var(--brass) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    color: var(--steel);
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
  }
  .ctas {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .meta {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .proof {
    font-size: var(--fs-small);
    color: var(--steel);
  }
  .perks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
  }
  .perks li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .perks :global(.icon) {
    color: var(--brass);
  }
  .media {
    max-width: 22rem;
    width: 100%;
    margin-inline: auto;
  }
  @media (min-width: 480px) {
    .ctas {
      display: flex;
      flex-wrap: wrap;
    }
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: var(--space-6);
    }
    .media {
      max-width: none;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-7) var(--space-8);
    }
  }
</style>
